\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Controlled comparison at 4K tokens. \textbf  {Left}: Cross-entropy loss; Sinkhorn (blue) transitions sharply at epoch $\sim $800 while softmax (red) flatlines at 2.6. \textbf  {Right}: Alignment accuracy; Sinkhorn reaches 72\% while softmax plateaus at $\sim $20\% ($3.6\times $ gap). Both models use identical architecture, hyperparameters, and data.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:training_4k}{{1}{6}{Controlled comparison at 4K tokens. \textbf {Left}: Cross-entropy loss; Sinkhorn (blue) transitions sharply at epoch $\sim $800 while softmax (red) flatlines at 2.6. \textbf {Right}: Alignment accuracy; Sinkhorn reaches 72\% while softmax plateaus at $\sim $20\% ($3.6\times $ gap). Both models use identical architecture, hyperparameters, and data}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Training at 16K tokens with banded Sinkhorn ($W\!=\!2048$). Standard softmax attention exceeds available memory at this context length (annotated). Banded Sinkhorn trains to completion, exhibiting the same characteristic phase transition observed at 4K.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:training_16k}{{2}{6}{Training at 16K tokens with banded Sinkhorn ($W\!=\!2048$). Standard softmax attention exceeds available memory at this context length (annotated). Banded Sinkhorn trains to completion, exhibiting the same characteristic phase transition observed at 4K}{figure.2}{}}
