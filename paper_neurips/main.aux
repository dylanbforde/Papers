\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Real benchmark outputs from controlled ablation at 4K tokens on TPU. \textbf  {(a)} Pallas Sinkhorn: loss drops sharply and accuracy reaches $>$60\%. \textbf  {(b)} Softmax attention: loss flatlines at 2.7 and accuracy crawls to $\sim $19\%. Same model, same data, same hyperparameters.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:ablation}{{3}{7}{Real benchmark outputs from controlled ablation at 4K tokens on TPU. \textbf {(a)} Pallas Sinkhorn: loss drops sharply and accuracy reaches $>$60\%. \textbf {(b)} Softmax attention: loss flatlines at 2.7 and accuracy crawls to $\sim $19\%. Same model, same data, same hyperparameters}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Attention-only latency (fwd+bwd) on TPU v6e-1. ``Normal'' and ``Flash'' are softmax-based (single normalization pass). Sinkhorn latency is higher due to 15 iterative normalization passes, but enables doubly-stochastic transport that softmax cannot provide. Banded Sinkhorn ($W\!=\!2048$) reduces cost from $O(L^2)$ to $O(L{\cdot }W)$ while extending to 131K tokens.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:latency}{{2}{7}{Attention-only latency (fwd+bwd) on TPU v6e-1. ``Normal'' and ``Flash'' are softmax-based (single normalization pass). Sinkhorn latency is higher due to 15 iterative normalization passes, but enables doubly-stochastic transport that softmax cannot provide. Banded Sinkhorn ($W\!=\!2048$) reduces cost from $O(L^2)$ to $O(L{\cdot }W)$ while extending to 131K tokens}{table.2}{}}
